<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
  <property>
    <name>yarn.resourcemanager.hostname</name>
    <value>master</value>
  </property>
  <property>
    <name>yarn.nodemanager.aux-services</name>
    <value>mapreduce_shuffle</value>
  </property>
  <property>
    <name>yarn.nodemanager.aux-services.mapreduce_shuffle.class</name>
    <value>org.apache.hadoop.mapred.ShuffleHandler</value>
  </property>

  <!-- Recursos para equipos modestos. Sin esto, cada NodeManager anuncia 8 GB y
       8 vcores aunque el equipo no los tenga, y YARN reparte memoria que no existe. -->
  <property>
    <!-- Memoria que cada trabajador ofrece a YARN (Memory Total = esto × trabajadores) -->
    <name>yarn.nodemanager.resource.memory-mb</name>
    <value>1536</value>
  </property>
  <property>
    <name>yarn.nodemanager.resource.cpu-vcores</name>
    <value>2</value>
  </property>
  <property>
    <!-- Minimum Allocation: cada petición se redondea a múltiplos de este valor -->
    <name>yarn.scheduler.minimum-allocation-mb</name>
    <value>256</value>
  </property>
  <property>
    <!-- Maximum Allocation: el mayor contenedor que se puede pedir -->
    <name>yarn.scheduler.maximum-allocation-mb</name>
    <value>1536</value>
  </property>
  <property>
    <!-- La comprobación de memoria virtual mata contenedores Java pequeños sin motivo real -->
    <name>yarn.nodemanager.vmem-check-enabled</name>
    <value>false</value>
  </property>
</configuration>
